# ===== Database =====
POSTGRES_USER=lrag
POSTGRES_PASSWORD=lrag
POSTGRES_DB=lrag
POSTGRES_PORT=5432

# Local backend dev (when not using docker network):
# DATABASE_URL=postgresql+psycopg://lrag:lrag@localhost:5432/lrag

# ===== Backend =====
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Comma separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== LLM Provider =====
# Provider: openai | deepseek | qwen
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxx
# Optional override base url, e.g. for deepseek/qwen OpenAI compatible endpoints
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=

# ===== RAG =====
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ===== Conversation Memory =====
# 一次对话最多回放的历史消息条数（仅含 user/assistant）。
MAX_HISTORY_MESSAGES=10
# 一次请求拼接到 LLM 的总输入 token 上限（含 system / 历史 / RAG context /
# 当前问题）。超过则从最早历史开始丢弃。
MAX_CONTEXT_TOKENS=4000

# ===== Debug =====
# 调试用：开启后会在 INFO 日志打印每次发给 LLM 的完整 messages（超长字段截断）。
# 生产环境务必置 false，避免 PII 泄露与日志膨胀。
LOG_LLM_MESSAGES=false
LOG_LLM_MESSAGE_MAX_CHARS=800

# ===== Upload =====
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20

# ===== Frontend =====
NEXT_PUBLIC_API_BASE=http://localhost:8000
