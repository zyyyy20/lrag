# ===== Database =====
POSTGRES_USER=lrag
POSTGRES_PASSWORD=lrag
POSTGRES_DB=lrag
POSTGRES_PORT=5432

# Local backend dev, for PyCharm or uvicorn running outside Docker:
# DATABASE_URL=postgresql+psycopg://lrag:lrag@localhost:5432/lrag

# ===== Backend =====
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== LLM Provider =====
# Provider: openai | deepseek | qwen
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxx
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
# Optional override base URL, for DeepSeek/Qwen OpenAI-compatible endpoints.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=

# ===== RAG =====
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ===== Agent / Tools =====
# Backend: langgraph
AGENT_BACKEND=langgraph
ENABLE_AGENT_RAG=true

# ===== LangGraph Checkpoint Memory =====
# Optional. Leave empty to derive from DATABASE_URL automatically.
# For local PyCharm dev, either leave it empty or use:
# LANGGRAPH_CHECKPOINT_URL=postgresql://lrag:lrag@localhost:5432/lrag
# For Docker, docker-compose.yml overrides this to use the postgres service host.
# LANGGRAPH_CHECKPOINT_URL=

# ===== Long-Term User Memory (Mem0) =====
# Disabled by default. Enable to persist cross-session user memories in Mem0.
MEM0_ENABLED=false
MEM0_API_KEY=
MEM0_TOP_K=5
MEM0_AGENT_ID=lrag

# ===== MCP Tools: Tavily Web Search =====
# Enable to expose Tavily MCP tools to the LangGraph agent.
MCP_TAVILY_ENABLED=false
MCP_TAVILY_URL=https://mcp.tavily.com/mcp/
MCP_TAVILY_API_KEY=
MCP_TAVILY_TRANSPORT=streamable_http

# ===== Public Knowledge Base =====
# all: any debug user can create/update/delete public KB content
# creator_only: only the creator can update/delete their own uploaded content
# disabled: read-only public KB
PUBLIC_KB_WRITE_MODE=all

# ===== Upload / Static =====
UPLOAD_DIR=./uploads
STATIC_DIR=./static
MAX_UPLOAD_MB=20

# ===== Frontend =====
NEXT_PUBLIC_API_BASE=http://localhost:8000
